<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dena.video-studio</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BINARY__</string>
    <string>__PROJECT_ROOT__/scripts/studio.mjs</string>
    <string>--port</string>
    <string>4777</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__EXECUTABLE_PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>StandardOutPath</key>
  <string>__LOG_DIRECTORY__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIRECTORY__/stderr.log</string>
</dict>
</plist>
