# Repliz public API. Keep real values in .env only.
REPLIZ_API_BASE_URL=
REPLIZ_ACCESS_KEY=
REPLIZ_SECRET_KEY=

# Cloudflare R2 public delivery. Upload uses Wrangler auth, not S3 keys.
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PREFIX=
CLOUDFLARE_ACCOUNT_ID=

# Optional target accounts. Empty platforms are skipped.
REPLIZ_FACEBOOK_ACCOUNT_ID=
REPLIZ_YOUTUBE_ACCOUNT_ID=
REPLIZ_TIKTOK_ACCOUNT_ID=
REPLIZ_INSTAGRAM_ACCOUNT_ID=
