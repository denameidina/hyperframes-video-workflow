# dependencies
node_modules/

# local environment
.env
.env.*
!.env.example

# raw inputs and rendered/intermediate video work
/raw/*
!/raw/.gitkeep
/videos/*
!/videos/.gitkeep
/references/*
!/references/.gitkeep
/renders/*
!/renders/.gitkeep

# media/render artifacts if created outside videos/
*.mp4
*.mov
*.m4v
*.webm
# example assets that must ship with the repo (media is otherwise ignored)
!docs/agents/references/style-examples/assets/*.webm
*.mp3
*.wav
*.m4a

# caches and temporary files
.DS_Store
.cache/
.wrangler/
tmp/
temp/
*.log

# Whisper
vendor/whisper.cpp

# moodboard: real stills of other people's work stay local (RD-03-59, ADR-0018)
docs/agents/references/moodboard/local/
