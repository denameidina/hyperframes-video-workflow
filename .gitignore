# dependencies
node_modules/

# local environment
.env
.env.*
!.env.example

# raw inputs and rendered/intermediate video work
/raw/*
!/raw/.gitkeep
/videos/*
!/videos/.gitkeep
/references/*
!/references/.gitkeep
/renders/*
!/renders/.gitkeep

# media/render artifacts if created outside videos/
*.mp4
*.mov
*.m4v
*.webm
*.mp3
*.wav
*.m4a

# caches and temporary files
.DS_Store
.cache/
tmp/
temp/
*.log

# Whisper
vendor/whisper.cpp
